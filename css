:root {
    --blood-red: #880808;
    --dark-bg: #0a0a0a;
    --card-bg: #1a1a1a;
    --text-main: #ffffff;
    --text-dim: #b3b3b3;
}

body.blood-theme {
    background-color: var(--dark-bg);
    color: var(--text-main);
    font-family: 'Segoe UI', Roboto, sans-serif;
}

.badge-verified {
    background-color: var(--blood-red);
    color: white;
    border-radius: 50%;
    padding: 2px 5px;
    font-size: 10px;
    margin-left: 5px;
}

.conversation {
    display: flex;
    padding: 15px;
    border-bottom: 1px solid #222;
    transition: background 0.3s;
}

.conversation:active {
    background: #222;
}